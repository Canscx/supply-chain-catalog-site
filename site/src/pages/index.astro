---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import ScopeMap from "../components/ScopeMap.astro";
import RulerNav from "../components/RulerNav.astro";
import Thresholds from "../components/Thresholds.astro";
import CooperationFlow from "../components/CooperationFlow.astro";
import AboutUs from "../components/AboutUs.astro";
import ContactUs from "../components/ContactUs.astro";
import { catalog } from "../data/catalog";

const { categories, chains } = catalog.totals;

/** 章节刻度：只保留六个主刻度。 */
const rulerItems = [
  { id: "hero", label: "总览" },
  { id: "scope", label: "业务范围" },
  { id: "thresholds", label: "准入门槛" },
  { id: "flow", label: "合作流程" },
  { id: "about", label: "关于我们" },
  { id: "contact", label: "联系我们" },
];
---

<Base
  title="企业供应链 · 产品链条"
  description={`企业陪跑俱乐部 · 覆盖 ${categories} 个品类、${chains} 条源头供应链。按链条供货，不按单品。`}
>
  <Nav current="home" />

  <RulerNav items={rulerItems} belowTools />

  <main id="main" data-inline>
    <section class="hero" id="hero">
      <div class="wrap">
        <div class="hero-fact">
          <span>覆盖 <b>{categories}</b> 个品类</span>
          <span aria-hidden="true">·</span>
          <span><b>{chains}</b> 条产品链条</span>
        </div>
        <h1 class="display"><span class="display-line-1">企业陪跑俱乐部，</span><br /><span class="display-line-2"><span class="display-hi">100+</span>源头供应链</span></h1>

        <div class="hero-actions hero-actions--cta">
          <a class="hero-cta" href="https://zjtx.peipaoclub.com/" target="_blank" rel="noopener noreferrer">
            <span>专精特新自评入口</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <a class="hero-cta" href="https://xjr.peipaoclub.com/" target="_blank" rel="noopener noreferrer">
            <span>小巨人自评入口</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
      </div>
    </section>

    <div class="inline-tools" id="tools">
      <div class="wrap">
        <div class="field">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.4"/><path d="M15.6 15.6l4.2 4.2"/></svg>
          <label class="sr-only" for="q-inline">搜索产品名称</label>
          <input id="q-inline" type="search" placeholder="搜索产品名称，如 玉米、锂电池" autocomplete="off" data-search />
          <button class="field-clear" type="button" data-search-clear aria-label="清空搜索">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
          </button>
        </div>
      </div>
    </div>

    <ScopeMap />

    <section class="rail-section" id="results">
      <div class="wrap">
        <div class="results-bar" data-anchor tabindex="-1">
          <span class="results-count" data-count></span>
          <button class="reset-btn" type="button" data-reset hidden>清空筛选</button>
        </div>

        <div data-groups>
          {
            catalog.categories.map((cat, i) => (
              <section class="group" id={`group-${cat.id}`} data-group={cat.id} data-cat-name={cat.name} data-open={i === 0 ? "true" : "false"}>
                <button class="group-toggle" type="button" aria-expanded={i === 0 ? "true" : "false"}>
                  <span class="group-title">
                    <span class="group-emoji" aria-hidden="true">{cat.emoji}</span>
                    <span class="group-name">{cat.name}</span>
                    <span class="group-n">{cat.chains.length}</span>
                  </span>
                  <svg class="group-chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9.5l6 6 6-6"/></svg>
                </button>
                <div class="group-chains">
                  <ul class="chain-list">
                    {cat.chains.map((c) => (
                      <li data-chain={c.name} data-alias={c.aliases.join(" ")}>
                        <a
                          class="chain"
                          href={`./catalog.html?category=${cat.id}&q=${encodeURIComponent(c.base)}`}
                          data-name={c.name}
                          data-alias={c.aliases.join(" ")}
                        >{c.name}</a>
                      </li>
                    ))}
                  </ul>
                </div>
              </section>
            ))
          }
        </div>

        <div class="empty" data-empty hidden>
          <h3>未找到匹配的产品链条</h3>
          <p>换一个关键词，或清空来源品类后再试。</p>
          <button class="btn" type="button" data-reset-empty>清空筛选</button>
        </div>
      </div>
    </section>

    <Thresholds />
    <CooperationFlow />
    <AboutUs />
    <ContactUs />
  </main>

  <Footer />
</Base>

<script>
  import "../scripts/theme";
  import "../scripts/nav";
  import "../scripts/inline";
  import "../scripts/ruler";
  import "../scripts/copy";
  import "../scripts/consult";
</script>
