---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import HeroCatalog from "../components/HeroCatalog.astro";
import Footer from "../components/Footer.astro";
import ScopeMap from "../components/ScopeMap.astro";
import RulerNav from "../components/RulerNav.astro";
import Thresholds from "../components/Thresholds.astro";
import CooperationFlow from "../components/CooperationFlow.astro";
import AboutUs from "../components/AboutUs.astro";
import ContactUs from "../components/ContactUs.astro";
import { catalog } from "../data/catalog";
import { SEARCH_VISIBLE } from "../config";

const { categories, chains } = catalog.totals;

/** 章节刻度：只保留六个主刻度。 */
const rulerItems = [
  { id: "hero", label: "总览" },
  { id: "scope", label: "增量品类明细" },
  { id: "thresholds", label: "准入门槛" },
  { id: "flow", label: "合作流程" },
  { id: "about", label: "关于我们" },
  { id: "contact", label: "联系我们" },
];
---

<Base
  title="企业供应链 · 产品链条"
  description={`企业陪跑俱乐部 · 覆盖 ${categories} 个品类、${chains} 条源头供应链。按链条供货，不按单品。`}
>
  <Nav current="home" />

  <RulerNav items={rulerItems} belowTools={SEARCH_VISIBLE} />

  <main id="main" data-inline>
    <section class="hero" id="hero">
      <div class="wrap hero-catalog-layout">
        <div class="hero-intro">
          <div class="hero-fact">
            <span>覆盖 <b>{categories}</b> 个品类</span>
            <span aria-hidden="true">·</span>
            <span><b>{chains}</b> 条产品链条</span>
          </div>
          <h1 class="display"><span class="display-line-1">企业陪跑俱乐部，</span><br /><span class="display-line-2"><span class="display-hi" data-count-up data-target="100">100+</span>源头供应链</span></h1>

          <div class="hero-actions hero-actions--cta">
            <a class="hero-cta" href="https://zjtx.peipaoclub.com/" target="_blank" rel="noopener noreferrer">
              <span>专精特新自评入口</span>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
            <a class="hero-cta" href="https://xjr.peipaoclub.com/" target="_blank" rel="noopener noreferrer">
              <span>小巨人自评入口</span>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          </div>
        </div>
        <HeroCatalog />
      </div>

      <a class="hero-hint" href="#scope" data-scroll-hint>
        <span class="hero-hint-text">往下滑动查看增量品类明细</span>
        <svg class="hero-hint-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14"/><path d="M6.5 13.5 12 19l5.5-5.5"/></svg>
      </a>
    </section>

    <div class="inline-tools" id="tools">
      <div class="wrap">
        <div class="field">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.4"/><path d="M15.6 15.6l4.2 4.2"/></svg>
          <label class="sr-only" for="q-inline">搜索产品名称</label>
          <input id="q-inline" type="search" placeholder="搜索产品名称，如 玉米、锂电池" autocomplete="off" data-search />
          <button class="field-clear" type="button" data-search-clear aria-label="清空搜索">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
          </button>
        </div>
      </div>
    </div>

    <ScopeMap />

    <Thresholds />
    <CooperationFlow />
    <AboutUs />
    <ContactUs />
  </main>

  <Footer />
</Base>

<script>
  import "../scripts/theme";
  import "../scripts/nav";
  import "../scripts/inline";
  import "../scripts/hint";
  import "../scripts/ruler";
  import "../scripts/reveal";
  import "../scripts/copy";
  import "../scripts/consult";
</script>
