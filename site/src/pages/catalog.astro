---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import RulerNav from "../components/RulerNav.astro";
import { catalog } from "../data/catalog";

const { chains } = catalog.totals;

/** 章节刻度：标题区 + 20 个品类，均为大格。 */
const rulerItems = [
  { id: "catalog-head", label: "目录" },
  ...catalog.categories.map((c) => ({ id: `group-${c.id}`, label: c.name })),
];
---

<Base
  title="产品链条目录 · 企业供应链"
  description={`按品类浏览与检索 ${chains} 条产品链条。`}
  bodyClass="catalog-page"
>
  <Nav current="catalog" />

  <RulerNav items={rulerItems} />

  <main id="main" data-catalog>
    <div class="catalog-head" id="catalog-head">
      <div class="wrap">
        <a class="back" href="./index.html">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6"/></svg>
          返回首页
        </a>
        <h1 class="display">产品链条目录</h1>

        <div class="catalog-search">
          <div class="field">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.4"/><path d="M15.6 15.6l4.2 4.2"/></svg>
            <label class="sr-only" for="q">搜索产品名称</label>
            <input id="q" type="search" placeholder="搜索产品名称，如 玉米、锂电池" autocomplete="off" data-search />
            <button class="field-clear" type="button" data-search-clear aria-label="清空搜索">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
            </button>
          </div>
        </div>

        <div class="cat-select">
          <label for="cat-sel">品类</label>
          <span class="sel-wrap">
            <select id="cat-sel" data-cat-select>
              <option value="all">全部分类（{chains}）</option>
              {catalog.categories.map((c) => (
                <option value={c.id}>{c.name}（{c.chains.length}）</option>
              ))}
            </select>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9.5l6 6 6-6"/></svg>
          </span>
        </div>
      </div>
    </div>

    <div class="catalog-body">
      <div class="wrap">
        <div class="catalog-grid">
          <aside class="cat-rail">
            <p class="cat-rail-label">业务分类</p>
            <div class="cat-list" role="group" aria-label="品类筛选">
              <button class="cat-item" type="button" data-cat="all">
                全部分类<span class="cat-n">{chains}</span>
              </button>
              {catalog.categories.map((c) => (
                <button class="cat-item" type="button" data-cat={c.id}>
                  {c.name}<span class="cat-n">{c.chains.length}</span>
                </button>
              ))}
            </div>
          </aside>

          <div>
            <div class="results-bar">
              <span class="results-count" data-count></span>
              <button class="reset-btn" type="button" data-reset hidden>清空筛选</button>
            </div>

            <div data-groups>
              {catalog.categories.map((cat) => (
                <section class="group" id={`group-${cat.id}`} data-group={cat.id} data-open="false">
                  <button class="group-toggle" type="button" aria-expanded="false">
                    <span class="group-title">
                      <span class="group-name">{cat.name}</span>
                      <span class="group-n">{cat.chains.length}</span>
                    </span>
                    <svg class="group-chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9.5l6 6 6-6"/></svg>
                  </button>
                  <div class="group-chains">
                    <ul class="chain-list">
                      {cat.chains.map((c) => (
                        <li>
                          <a
                            class="chain"
                            href={`./catalog.html?category=${cat.id}&q=${encodeURIComponent(c.base)}`}
                            data-name={c.name}
                            data-base={c.base}
                            data-alias={c.aliases.join(" ")}
                          >
                            {c.name}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </section>
              ))}
            </div>

            <div class="empty" data-empty hidden>
              <h3>未找到匹配的产品链条</h3>
              <p>换一个关键词，或清空筛选回到全部分类。</p>
              <button class="btn" type="button" data-reset-empty>清空筛选</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer contact={false} />
</Base>

<script>
  import "../scripts/theme";
  import "../scripts/nav";
  import "../scripts/catalog";
  import "../scripts/ruler";
</script>
