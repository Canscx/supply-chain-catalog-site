---
<svg class="catalog-plate" viewBox="0 0 560 320" fill="none" aria-hidden="true">
  <defs>
    <linearGradient id="pcb-coating" x2="1" y2="1" gradientUnits="objectBoundingBox"><stop stop-color="var(--plate-board-light)"/><stop offset=".5" stop-color="var(--plate-board)"/><stop offset="1" stop-color="var(--plate-panel)"/></linearGradient>
    <linearGradient id="pcb-silicon" x2=".85" y2="1" gradientUnits="objectBoundingBox"><stop stop-color="var(--plate-panel-light)"/><stop offset="1" stop-color="var(--plate-dark)"/></linearGradient>
    <linearGradient id="pcb-steel" x2=".45" y2="1" gradientUnits="objectBoundingBox"><stop stop-color="var(--plate-white)"/><stop offset=".52" stop-color="var(--plate-sage)"/><stop offset="1" stop-color="var(--plate-steel)"/></linearGradient>
    <radialGradient id="pcb-ground"><stop stop-color="var(--plate-shadow)" stop-opacity=".52"/><stop offset="1" stop-color="var(--plate-shadow)" stop-opacity="0"/></radialGradient>
  </defs>
  <ellipse class="plate-surface" cx="279" cy="266" rx="221" ry="36" fill="url(#pcb-ground)"/>
  <g transform="rotate(-7 280 160)">
    <g class="plate-outline">
      <path pathLength="1" class="plate-fill" fill="var(--plate-dark)" d="M120 57h313l15 13v178l-15 17H118l-21-18V75z"/>
      <path pathLength="1" class="plate-fill" fill="url(#pcb-coating)" d="M120 53h313l15 13v178l-15 16H118l-21-17V72z"/>
      <path pathLength="1" class="plate-glint" d="M126 60h302l11 10v170l-11 12H122l-17-14V77z"/>
    </g>
    <g class="plate-detail plate-traces">
      {traces.map((d) => <path pathLength="1" d={d}/>) }
      {vias.map(([x, y]) => <circle pathLength="1" cx={x} cy={y} r="2.2"/>) }
      <path pathLength="1" d="M143 81h48l17-10h45m51 1h60l23 16h27m-292 130v-15l17-13m194 55h65l24-21m-304-32v-23l19-14m281-72v44l-18 26v27"/>
    </g>
    <g class="plate-detail">
      {holes.map(([x,y]) => <g><circle pathLength="1" class="plate-fill" cx={x} cy={y} r="8" fill="var(--plate-warm)"/><circle pathLength="1" class="plate-fill" cx={x} cy={y} r="4.2" fill="var(--plate-dark)"/></g>)}
      {passives.map(([x,y,angle]) => <g transform={`translate(${x} ${y}) rotate(${angle})`}><rect pathLength="1" class="plate-fill" width="9" height="4.6" rx=".6" fill="var(--plate-warm)"/><path pathLength="1" d="M2 0v4.6M7 0v4.6"/></g>)}
      <path pathLength="1" class="plate-fill" fill="url(#pcb-steel)" d="M92 131h46v27H92zM94 173h36v29H94zM410 84h45v39h-45zm4 52h37v33h-37z"/>
      <path pathLength="1" class="plate-fill" fill="var(--plate-dark)" d="M94 135h17v19H94zm1 43h14v19H95zm343-89h14v28h-14zm0 52h11v22h-11z"/>
      <path pathLength="1" class="plate-glint" d="M114 135h18m-18 19h19m-20 24h11m-10 18h10m289-106h20m-20 27h20m-16 24h17m-17 21h17"/>
      <rect pathLength="1" class="plate-fill" x="234" y="119" width="84" height="84" rx="5" fill="var(--plate-dark)"/>
      {pins.map((pin) => <path pathLength="1" class="plate-pin" d={`M${234 + pin} 112v13m0 72v13 M227 ${119 + pin}h13m72 0h13`}/>)}
      <rect pathLength="1" class="plate-fill" x="246" y="131" width="60" height="60" rx="3" fill="url(#pcb-silicon)"/>
      <path pathLength="1" class="plate-glint" d="M254 143h43m-43 35h43m-36-19h17m-17 5h26m-26 5h12"/>
      {[[151,81],[151,100],[390,217],[405,236],[155,234]].map(([x,y]) => <g><circle pathLength="1" class="plate-fill" cx={x} cy={y} r="7.6" fill="url(#pcb-steel)"/><path pathLength="1" d={`M${x - 4} ${y}h8m-4-4v8`}/></g>)}
    </g>
    <path pathLength="1" class="plate-fine plate-glint" d="M143 138v16h16m-18 48v15h23m229-63h10v21m-8 53h-27v11M226 117v-7h12m83 94v7h-13"/>
  </g>
</svg>
