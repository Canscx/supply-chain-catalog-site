---
const cob = 'M273 39C254 39 241 56 236 78C229 104 225 141 227 173C229 212 240 235 264 239C288 242 307 220 314 183C322 148 321 113 316 84C312 58 296 37 273 39Z';
const rows = [
  // Height, centre and half-width measured along the same tapered silhouette.
  [44, 274, 19], [53, 275, 27], [63, 275, 34], [74, 276, 39], [86, 276, 43],
  [98, 276, 44], [110, 275, 46], [122, 275, 47], [134, 274, 48], [146, 273, 48],
  [158, 272, 48], [170, 272, 46], [182, 271, 44], [194, 270, 41], [206, 269, 37],
  [218, 267, 32], [229, 266, 25], [237, 264, 17],
];
const kernels = rows.map(([y, centre, radius], row) => {
  const count = Math.round(4 + radius / 10) + row % 2;
  const pitch = Math.PI / count;
  return Array.from({ length: count }, (_, col) => {
    const offset = -Math.PI / 2 + pitch * col;
    // Project the visible half of the cob. The outer kernels foreshorten;
    // across each row the same curve wraps around the crown of the cob.
    const left = Math.sin(offset) * radius;
    const right = Math.sin(offset + pitch) * radius;
    const angle = offset + pitch / 2;
    const variation = Math.sin(col * 3.7 + row * 2.4);
    return {
      x: centre + (left + right) / 2,
      y: y + (Math.cos(angle) - 1) * 4 + variation * .55,
      width: (right - left) * .53 + .2,
      height: (row === 0 || row === rows.length - 1 ? 4.8 : 6.1) + variation * .4,
      turn: Math.sin(angle) * -11 + variation * 3,
    };
  });
});
const wheat = [
  { x: 265, y: 269, tilt: -34, size: .98 },
  { x: 279, y: 268, tilt: 36, size: .91 },
];
const spikelets = Array.from({ length: 9 }, (_, index) => ({
  x: -8 + index * .57,
  y: -204 + index * 8.1,
  width: 6.2 + Math.sin((index + 1) / 10 * Math.PI) * 6,
  awn: 18 + index * .8,
}));
---
<svg class="catalog-plate" viewBox="0 0 560 320" fill="none" aria-hidden="true">
  <defs>
    <linearGradient id="harvest-kernel" x2=".85" y2="1">
      <stop stop-color="var(--plate-gold-light)"/><stop offset=".62" stop-color="var(--plate-warm)"/><stop offset="1" stop-color="var(--plate-gold-dark)"/>
    </linearGradient>
    <linearGradient id="harvest-maize" gradientUnits="userSpaceOnUse" x1="227" y1="123" x2="319" y2="123">
      <stop stop-color="var(--plate-warm)"/><stop offset=".31" stop-color="var(--plate-gold-ink)"/><stop offset="1" stop-color="var(--plate-gold-dark)"/>
    </linearGradient>
    <linearGradient id="harvest-turn" gradientUnits="userSpaceOnUse" x1="225" y1="100" x2="321" y2="100">
      <stop stop-color="var(--plate-gold-ink)" stop-opacity=".29"/><stop offset=".21" stop-color="var(--plate-gold-light)" stop-opacity=".15"/><stop offset=".53" stop-color="var(--plate-gold-dark)" stop-opacity="0"/><stop offset="1" stop-color="var(--plate-shadow)" stop-opacity=".36"/>
    </linearGradient>
    <linearGradient id="harvest-leaf" x2="1" y2=".58">
      <stop stop-color="var(--plate-board)"/><stop offset=".52" stop-color="var(--plate-sage)"/><stop offset="1" stop-color="var(--plate-mist)"/>
    </linearGradient>
    <linearGradient id="harvest-fold" x1=".08" y1="1" x2=".94" y2=".05">
      <stop stop-color="var(--plate-steel)"/><stop offset=".55" stop-color="var(--plate-board-light)"/><stop offset="1" stop-color="var(--plate-sage)"/>
    </linearGradient>
    <linearGradient id="harvest-straw" x2="1" y2="1">
      <stop stop-color="var(--plate-gold-light)"/><stop offset="1" stop-color="var(--plate-warm)"/>
    </linearGradient>
    <radialGradient id="harvest-ground"><stop stop-color="var(--plate-shadow)" stop-opacity=".41"/><stop offset="1" stop-color="var(--plate-shadow)" stop-opacity="0"/></radialGradient>
    <clipPath id="harvest-cob-clip"><path d={cob}/></clipPath>
  </defs>
  <g class="plate-surface">
    <ellipse cx="279" cy="280" rx="150" ry="19" fill="url(#harvest-ground)"/>
    <ellipse cx="275" cy="277" rx="47" ry="7" fill="url(#harvest-ground)"/>
  </g>
  {wheat.map(({ x, y, tilt, size }) => (
    <g transform={`translate(${x} ${y}) rotate(${tilt}) scale(${size})`}>
      <g class="plate-outline plate-harvest-ink">
        <path pathLength="1" class="plate-fill" fill="url(#harvest-straw)" d="M-10-211c4 30 6 63 5 93C-6-79-10-43-2 1q2 2 4 0c-8-43-3-80-3-119 1-31-2-63-7-93z"/>
      </g>
      <g class="plate-detail plate-harvest-ink">
        {spikelets.map(({ x, y, width }) => (
          <g transform={`translate(${x} ${y})`}>
            <path pathLength="1" class="plate-fill" fill="url(#harvest-straw)" d={`M2 3C${-width * .62} 1 ${-width - 1} -6 ${-width} -15c${width * .65} 2 ${width + 2} 9 ${width + 2} 18Z`}/>
            <path pathLength="1" class="plate-fill" fill="url(#harvest-straw)" d={`M2 9C${width * .78} 6 ${width + 3} -2 ${width + 1} -11C${width * .48} -8 1 -2 2 9Z`}/>
          </g>
        ))}
      </g>
      <g class="plate-fine plate-harvest-ink">
        {spikelets.map(({ x, y, width, awn }) => (
          <path pathLength="1" d={`M${x - width} ${y - 15}q-5 -7 -9 ${-awn}M${x + width + 1} ${y - 11}q4 -7 7 ${-awn - 1}`}/>
        ))}
        <path pathLength="1" d="M-9-211q-3-11-4-22"/>
      </g>
      <g class="plate-detail">
        <path pathLength="1" class="plate-fill" fill="url(#harvest-leaf)" d="M-4-91c-7-16-29-25-39-38 9 24 23 39 39 41zm2 35c9-17 23-24 43-24-12 12-27 14-43 27z"/>
        <path pathLength="1" class="plate-glint" d="M-37-122q7 12 31 30m42 14q-18 5-36 21"/>
      </g>
    </g>
  ))}
  <g transform="rotate(12 273 254)">
    <g class="plate-outline">
      <path pathLength="1" class="plate-fill" fill="url(#harvest-fold)" d="M268 252c-32-11-56-34-68-61-14-28-10-52-26-82 17 8 32 23 45 45 15 24 26 61 54 89z"/>
      <path pathLength="1" class="plate-fill" fill="url(#harvest-leaf)" d="M280 249c16-22 26-43 31-67 6-26 22-54 43-67-10 19-10 33-13 58-4 38-28 68-53 83z"/>
      <path pathLength="1" class="plate-fill plate-harvest-ink" fill="url(#harvest-maize)" d={cob}/>
    </g>
    <g clip-path="url(#harvest-cob-clip)">
      <g class="plate-detail plate-kernels">
        {kernels.flat().map(({x, y, width, height, turn}) => (
          <path pathLength="1" class="plate-fill" fill="url(#harvest-kernel)" vector-effect="non-scaling-stroke"
            transform={`translate(${x.toFixed(2)} ${y.toFixed(2)}) rotate(${turn.toFixed(2)}) scale(${width.toFixed(2)} ${height.toFixed(2)})`}
            d="M-.8-.62C-.62-.96 .39-1.04 .73-.81Q1.04-.59 1-.03C1 .43 .74 .79 .42 .92Q-.09 1.12-.69 .86C-.98 .65-1 .18-.97-.16Q-.94-.47-.8-.62Z"/>
        ))}
      </g>
      <path pathLength="1" class="plate-fill plate-detail" fill="url(#harvest-turn)" stroke="none" d={cob}/>
    </g>
    <g class="plate-fine plate-harvest-ink">
      <path pathLength="1" d="M262 42c-9-9-8-13-16-16m20 14c-5-7-3-14-8-20m12 19c-3-11 1-16-2-24m8 24c0-10 5-14 7-21m-4 22c6-6 7-11 14-15m-9 17c8-4 12-9 20-11"/>
    </g>
    <g class="plate-detail">
      <!-- The cut stem sits under both husks. Each folded face meets the same base. -->
      <path pathLength="1" class="plate-fill" fill="url(#harvest-fold)" d="M263 246q10-8 21 0l-4 25q-1 7-8 8-9 0-12-7z"/>
      <path pathLength="1" class="plate-fill" fill="var(--plate-sage)" d="M260 270q10-4 20 2-2 7-9 7-8-1-11-5z"/>
      <path pathLength="1" class="plate-fill" fill="url(#harvest-leaf)" d="M267 260c-14-4-29-13-39-27-11-14-16-30-21-47-5-14-11-23-21-33 17 4 32 14 42 28 9 13 12 27 27 39 13 12 23 24 12 40z"/>
      <path pathLength="1" class="plate-fill" fill="url(#harvest-fold)" d="M267 260c-8-2-21-8-32-20-12-13-19-27-25-48 10 16 18 30 32 41 8 7 17 13 27 15z"/>
      <path pathLength="1" class="plate-fill" fill="url(#harvest-leaf)" d="M268 261c-5-15 4-30 22-44 9-7 19-12 30-19 13-8 23-17 30-30-2 19-7 38-22 54-16 19-37 29-58 39z"/>
      <path pathLength="1" class="plate-fill" fill="url(#harvest-fold)" d="M268 261c14-16 33-25 53-41 11-9 20-23 27-39-4 17-10 31-20 41-16 19-37 29-58 39z"/>
      <path pathLength="1" class="plate-glint" d="M191 158c24 19 22 47 44 69m108-48c-10 16-22 24-39 34-14 8-23 18-29 27m69-115c-15 19-18 45-26 63"/>
    </g>
    <g class="plate-fine plate-orbit">
      <path pathLength="1" d="M216 189q10 27 34 43m-26-24q9 19 26 31m73-29q-21 12-31 23m16-10q-12 7-20 15m-102-119q19 22 31 52m55 96-1 5"/>
    </g>
  </g>
</svg>
