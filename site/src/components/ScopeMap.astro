---
import { catalog } from "../data/catalog";

const totalChains = catalog.totals.chains;
---

<section class="scope" id="scope" data-scope>
  <div class="wrap">
    <div class="section-head" data-reveal>
      <h2 class="section-heading">增量品类明细</h2>
      <span class="section-note">实时咨询为准</span>
    </div>

    <div class="scope-grid" data-scope-grid data-reveal>
      {
        catalog.categories.map((cat) => (
          <a
            class="scope-cell"
            href={"./catalog.html?category=" + cat.id}
            id={`scope-cat-${cat.id}`}
            data-scope-cat={cat.id}
            data-scope-search={[cat.name, ...cat.chains.flatMap((c) => [c.name, ...c.aliases]), "链条"].join(" ")}
            data-chain-count={cat.chains.length}
          >
            <span class="scope-cell-head">
              <span class="scope-name">
                <span class="scope-emoji" aria-hidden="true">{cat.emoji}</span>
                {cat.name}
              </span>
              <span class="scope-n">{cat.chains.length} 条</span>
            </span>
            <span class="scope-chains">
              {cat.chains.map((c, index) => (
                <span class="scope-chain">
                  {c.name}{index < cat.chains.length - 1 ? "、" : ""}
                </span>
              ))}
            </span>
          </a>
        ))
      }
      <a class="scope-all" href="./catalog.html" data-scope-all>
        <span class="scope-all-name">全部品类</span>
        <span class="scope-all-n">{totalChains} 条</span>
        <span class="scope-all-act">
          查看完整产品链条目录
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </span>
      </a>
    </div>

    <p class="scope-search-note" data-scope-search-note aria-live="polite" hidden></p>
  </div>
</section>
