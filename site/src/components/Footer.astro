---
import { catalog } from "../data/catalog";

interface Props {
  /** 是否展示「关于我们 / 联系我们」入口。 */
  contact?: boolean;
}
const { contact = true } = Astro.props;
const brand = "企业供应链";
const { categories, chains } = catalog.totals;
---

<footer class="foot">
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <div class="foot-brand">
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M9 15l6-6"/><path d="M11 6.5a4 4 0 0 1 5.7 5.6l-1.6 1.6"/><path d="M13 17.5a4 4 0 0 1-5.7-5.6l1.6-1.6"/></svg>
          </span>
          {brand}
        </div>
        <p class="foot-note">
          覆盖 {categories} 个品类、{chains} 条产品链条。
        </p>
        <div class="foot-actions">
          <a class="foot-action" href="https://vs.peipaoclub.com/">四类资质对比</a>
          <a class="foot-action" href="https://peipaoclub.com/">资产配置</a>
        </div>
      </div>

      <div class="foot-col">
        <h2>浏览</h2>
        <ul>
          <li><a href="./index.html">首页</a></li>
          <li><a href="./catalog.html">产品链条目录</a></li>
          <li><a href="./index.html#thresholds">准入门槛</a></li>
        </ul>
      </div>

      {contact && (
        <div class="foot-col">
          <h2>关于</h2>
          <ul>
            <li><a href="./index.html#about">关于我们</a></li>
            <li><a href="./index.html#contact">联系我们</a></li>
          </ul>
        </div>
      )}
    </div>

    <div class="foot-btm">
      <span>© 2026 {brand}</span>
    </div>
  </div>
</footer>
